# Copy to .env.local for local development. Never commit real values.

# Postgres connection strings
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pg_weddings_dev
# Used only by `npm run test:integration`; this database is wiped on every run.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/pg_weddings_test

# Who receives couple-facing messages.
#   off      - nothing is queued (default)
#   approval - messages are queued as awaiting_approval and never sent automatically
#   auto     - queued messages are sent by the dispatcher (only after Shane approves going live)
MESSAGING_MODE=approval

# Providers. Only "log" exists today; it writes to the server log and sends nothing.
SMS_PROVIDER=log
EMAIL_PROVIDER=log

# Shared secret for the cron endpoints (/api/cron/*). Use a long random string.
CRON_SECRET=change-me

# Public site URL, used in messages and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
